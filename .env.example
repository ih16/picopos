# Public browser configuration; see docs/development.md.
# Copy to .env.local for Google-connected development. Demo needs no values.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_PROJECT_NUMBER=

# Pass PUBLIC_ORIGIN in the shell when building for a deployed origin:
# PUBLIC_ORIGIN=https://www.picopos.app make build
