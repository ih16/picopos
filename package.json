{
  "name": "picopos",
  "version": "0.1.0",
  "homepage": "https://www.picopos.app/",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/secure-html.mjs && node scripts/build-offline-shell.mjs",
    "preview": "vite preview --config vite.preview.config.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "audit": "npm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@solid-primitives/event-listener": "^3.0.0",
    "@solid-primitives/media": "^4.0.0",
    "@solid-primitives/resize-observer": "^4.0.0",
    "@solid-primitives/virtual": "^1.0.1",
    "@solidjs/web": "2.0.3",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "^24.0.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
